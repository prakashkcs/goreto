<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Goreto</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Goreto</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Custom URL scheme for deep links: goreto://post/{postId} -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>goreto.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>goreto</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google.signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- REVERSED_CLIENT_ID from GoogleService-Info.plist. Google Sign-In
				     returns to the app through this scheme; without it the browser
				     completes sign-in and never comes back. -->
				<string>com.googleusercontent.apps.354056335842-ckeh6kmf5d7pm8orpasqrr6telh8on9s</string>
			</array>
		</dict>
	</array>
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Goreto uses your camera for video calls, live streams, profile photos, and hands-free blink scrolling.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Goreto uses your microphone for video and audio calls, live streams, and voice messages.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Goreto needs access to your photos so you can set a profile picture and share posts.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Goreto saves photos and videos you download to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Goreto uses your location to show people and matches near you and your approximate distance. Your exact location is never shown to others.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Goreto uses your location in the background to keep nearby discovery up to date. You can turn this off anytime in Settings.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>This lets us deliver more relevant ads and measure their performance. Your data is never sold.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Goreto uses the local network to discover nearby devices for offline proximity features.</string>
	<!-- flutter_blue_plus links CoreBluetooth, and Apple rejects an upload that
	     references those APIs without a purpose string (ITMS-90683) whether or
	     not the code path is reachable. BleProximityModule is currently dormant
	     - nothing calls startSecureDiscovery() - so no prompt is shown today;
	     this is here so the upload is not refused, and so the wording is
	     already honest if that module is switched on. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Goreto uses Bluetooth to find people near you when you turn on nearby discovery. Your identifier is rotated every 15 minutes and is never linked to your profile.</string>
	<!-- Google's public test AdMob App ID. REPLACE with the real iOS App ID
	     from your AdMob account before release, same as the Android manifest. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<!-- FCM data pushes: incoming calls and messages must wake the app. -->
		<string>remote-notification</string>
		<!-- Keeps call and live-stream audio alive when the app is not in front. -->
		<string>audio</string>
		<!-- flutter_background_service on iOS runs through BGTaskScheduler. -->
		<string>fetch</string>
		<string>processing</string>
		<!-- Nearby alerts keep updating position in the background. Drop this
		     together with NSLocationAlwaysAndWhenInUseUsageDescription if that
		     feature is ever cut; Apple reviews this mode closely. -->
		<string>location</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.flutter.background.refresh</string>
	</array>
</dict>
</plist>
