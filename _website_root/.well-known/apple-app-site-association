            "caseSensitive": false
          },
          {
            "/": "/post.php",
            "?": {
              "id": "?*"
            },
            "comment": "The share landing page for a single post."
          },
          {
            "/": "/profile.php",
            "?": {
              "id": "?*"
            },
            "comment": "A profile shared by id rather than by username."
          },
          {
            "/": "/*",
