<?xml version="1.0" encoding="utf-8"?>
<!-- "Someone is nearby" full-screen alert, in the app's dark neon style
     (pink #FF007F / purple #D946EF / cyan #06B6D4 on near-black). View ids
     are unchanged so NearbyAlertActivity keeps working. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0818"
    android:fitsSystemWindows="true">

    <!-- Their photo, blurred in code (Android 12+), as a soft backdrop -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        android:src="@drawable/ic_default_avatar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/neon_nearby_overlay" />

    <!-- Top bar: badge + close -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/neon_nearby_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.14"
            android:text="NEARBY"
            android:textColor="#FFE879F9"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/neon_nearby_close">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✕"
            android:textColor="#DDFFFFFF"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- Centre: radar rings + avatar + name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="70dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp">

        <FrameLayout
            android:layout_width="250dp"
            android:layout_height="250dp">

            <!-- Pulsing radar rings (animated in NearbyAlertActivity) -->
            <View
                android:id="@+id/ringOuter"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/neon_nearby_ring_outer" />

            <View
                android:id="@+id/ringInner"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center"
                android:background="@drawable/neon_nearby_ring_inner" />

            <!-- Gradient frame + avatar -->
            <FrameLayout
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/neon_nearby_avatar_frame"
                android:elevation="8dp"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/ivSenderAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/neon_nearby_avatar_bg"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_avatar" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#AAD946EF"
            android:shadowRadius="18"
            android:text="Someone"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />

        <!-- "is 14m away from you" pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/neon_nearby_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➤"
                android:textColor="#FF06B6D4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="is near you right now"
                android:textColor="#FFE0F7FA"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Say hi before they walk away 💫"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="36dp">

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/neon_nearby_btn_primary"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            android:text="Say Hi 👋"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnIgnore"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/neon_nearby_btn_secondary"
            android:stateListAnimator="@null"
            android:text="Not now"
            android:textAllCaps="false"
            android:textColor="#FF67E8F9"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
